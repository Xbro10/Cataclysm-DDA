  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_VALVE",
    "//": "Shuts every steam joint within 20 tiles for 2 days, then the pressure brings them back. Turning it is hard, slow and loud.",
    "condition": { "u_query": "Put your weight on the valve wheel and try to turn it?", "default": true },
    "effect": [
      { "u_location_variable": { "u_val": "br2_valve_point" } },
      { "turn_cost": "2 m" },
      { "u_make_sound": "a long shriek of metal and a bang in the pipes", "volume": 30, "type": "destructive_activity" },
      { "u_transform_radius": 20, "ter_furn_transform": "br2_valve_shut" },
      {
        "u_transform_radius": 20,
        "ter_furn_transform": "br2_valve_reopen",
        "target_var": { "u_val": "br2_valve_point" },
        "time_in_future": "2 days"
      },
      {
        "u_message": "The wheel fights you, then gives all at once.  Something bangs through the pipes, and up and down the tunnel the hissing dies away.  It won't hold forever.",
        "type": "good"
      }
    ],
    "false_effect": [ { "u_message": "You leave the wheel alone.", "type": "info" } ]
  },
