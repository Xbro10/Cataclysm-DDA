  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_STAIRS_DOWN",
    "condition": {
      "u_query": "The stairs go down into warm, wet dark, and the pipes below knock like something asking to be let in.  There may be no coming back the same way.  Go down?",
      "default": false
    },
    "effect": [ { "run_eocs": "EOC_BR_GO_L2" } ],
    "false_effect": [ { "u_message": "You step back from the top step.", "type": "info" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR_GO_L2",
    "//": "Level 1 -> Level 2. You land under where you were, at the foot of the nearest choked stairwell (one forms if none is within 30 tiles). Followers within 20 tiles come along. The stairs collapse behind you: the way back is a service ladder.",
    "effect": [
      {
        "u_travel_to_dimension": "backrooms_level_2",
        "npc_travel_radius": 20,
        "npc_travel_filter": "follower",
        "fail_message": "The stairs just go down to a concrete floor.  Nothing.",
        "success_message": "The stairs go on far longer than they should.  The air gets hotter with every flight."
      },
      { "u_location_variable": { "global_val": "br_ground_point" }, "z_adjust": 0, "z_override": true },
      { "u_teleport": { "global_val": "br_ground_point" }, "force_safe": true },
      {
        "u_location_variable": { "global_val": "br2_arrival_point" },
        "furniture": "f_br2_choked_stairs",
        "target_max_radius": 30,
        "y_adjust": 2,
        "false_eocs": [ "EOC_BR2_BUILD_LANDING" ]
      },
      { "u_teleport": { "global_val": "br2_arrival_point" }, "force_safe": true },
      { "u_run_npc_eocs": [ "EOC_BR2_FOLLOWER_TO_ARRIVAL" ], "local": true },
      {
        "u_message": "Behind you, with a long grinding roar, the stairwell fills with falling concrete.  The dust settles.  You're in a tunnel of pipes, and it's hot.",
        "type": "bad",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_BUILD_LANDING",
    "effect": [
      { "u_location_variable": { "global_val": "br_stamp_point" } },
      { "mapgen_update": "br2_landing_stamp", "target_var": { "global_val": "br_stamp_point" } },
      {
        "u_location_variable": { "global_val": "br2_arrival_point" },
        "furniture": "f_br2_choked_stairs",
        "target_max_radius": 30,
        "y_adjust": 2
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_FOLLOWER_TO_ARRIVAL",
    "condition": "u_following",
    "effect": [ { "u_teleport": { "global_val": "br2_arrival_point" }, "force_safe": true } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_CHOKED_STAIRS",
    "effect": [
      {
        "u_message": "You pull at a slab of concrete.  Three more slide down to take its place.  There's no digging through this.",
        "type": "bad"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_LADDER_UP",
    "condition": { "u_query": "The rungs climb into a hatch and cooler air.  Climb up?", "default": true },
    "effect": [ { "run_eocs": "EOC_BR_GO_L1_FROM_L2" } ],
    "false_effect": [ { "u_message": "You leave the ladder for now.", "type": "info" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR_GO_L1_FROM_L2",
    "//": "Level 2 -> Level 1. You come out of a floor hatch under where you were. Followers within 20 tiles come along.",
    "effect": [
      {
        "u_travel_to_dimension": "backrooms_level_1",
        "npc_travel_radius": 20,
        "npc_travel_filter": "follower",
        "fail_message": "The hatch won't budge.",
        "success_message": "You climb for a long time.  The hatch opens on cold concrete and the hum of a parking garage."
      },
      { "u_location_variable": { "global_val": "br_ground_point" }, "z_adjust": 0, "z_override": true },
      { "u_teleport": { "global_val": "br_ground_point" }, "force_safe": true },
      { "u_run_npc_eocs": [ "EOC_BR2_FOLLOWER_TO_GROUND" ], "local": true },
      {
        "u_message": "When you look down, the hatch is gone.  Just a square of newer concrete in the floor.",
        "type": "neutral"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR2_FOLLOWER_TO_GROUND",
    "condition": "u_following",
    "effect": [ { "u_teleport": { "global_val": "br_ground_point" }, "force_safe": true } ]
  }
]
