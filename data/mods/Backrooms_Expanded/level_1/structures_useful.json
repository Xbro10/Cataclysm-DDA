  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_GENERATOR_EXAMINE",
    "//": "Two litres of gasoline relights every dead ceiling light within 12 tiles for a week. Light draws Deathmoths and keeps Smilers back.",
    "condition": { "u_has_items": { "item": "gasoline", "charges": 2000 } },
    "effect": [ { "run_eocs": "EOC_BR1_GENERATOR_FUEL" } ],
    "false_effect": [
      {
        "u_message": "The tank is bone dry.  It would take a couple of litres of gasoline to get it going.",
        "type": "info"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_GENERATOR_FUEL",
    "condition": { "u_query": "Pour two litres of gasoline into the generator?", "default": true },
    "effect": [
      { "u_consume_item": "gasoline", "charges": 2000 },
      { "u_location_variable": { "global_val": "br1_generator_point" } },
      { "u_transform_radius": 12, "ter_furn_transform": "br1_generator_start" },
      {
        "u_transform_radius": 12,
        "ter_furn_transform": "br1_generator_stop",
        "target_var": { "global_val": "br1_generator_point" },
        "time_in_future": "7 days"
      },
      {
        "u_message": "The generator coughs, catches, and settles into a steady roar.  Overhead, dead lights flicker and come on, one after another.",
        "type": "good"
      }
    ]
  },
  {
    "type": "effect_on_condition",
