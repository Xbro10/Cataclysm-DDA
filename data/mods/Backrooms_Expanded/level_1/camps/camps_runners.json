  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_DIED",
    "//": "A dead runner frees the run slot and ends any search for them.",
    "effect": [ { "math": [ "br1_runner_out = 0" ] }, { "math": [ "br1_runner_missing = 0" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNERS_TICK",
    "//": "Every 10 minutes while the player is on Level 1 (often enough that a badly hurt runner turns home soon after a fight), each living runner takes one step of its errand (EOC_BR1_RUNNER_TICK, run as the runner). Runners in a level the player isn't on don't move, so this only runs on Level 1. br1_tick_depart is that runner's departure hour today (EOC_BR1_RUNNER_SCHEDULE).",
    "recurrence": [ "10 minutes", "10 minutes" ],
    "condition": { "current_dimension": "backrooms_level_1" },
    "effect": [
      { "run_eocs": "EOC_BR1_RUNNER_SCHEDULE" },
      {
        "if": { "math": [ "br1_runner_dead_1 != 1" ] },
        "then": [
          { "math": [ "br1_tick_who = 1" ] },
          { "math": [ "br1_tick_depart = br1_depart_1" ] },
          { "u_run_npc_eocs": [ "EOC_BR1_RUNNER_TICK" ], "unique_ids": [ "BR1_runner_jonah" ] }
        ]
      },
      {
        "if": { "math": [ "br1_runner_dead_2 != 1" ] },
        "then": [
          { "math": [ "br1_tick_who = 2" ] },
          { "math": [ "br1_tick_depart = br1_depart_2" ] },
          { "u_run_npc_eocs": [ "EOC_BR1_RUNNER_TICK" ], "unique_ids": [ "BR1_runner_rosa" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_SCHEDULE",
    "//": "Once a day (first tick or board read after midnight), Dot chalks up each runner's departure hour for the day: 6 AM to 5 PM, never the same hour for both. br1_sched_day is the day number counted from 1 (so it never matches an unset 0); br1_sched_midnight is that day's midnight. br1_depart_N_h / _ap are the hour in 12-hour form for the board.",
    "condition": { "math": [ "br1_sched_day != (time('now') - time_since('midnight')) / 86400 + 1" ] },
    "effect": [
      { "math": [ "br1_sched_midnight = time('now') - time_since('midnight')" ] },
      { "math": [ "br1_sched_day = br1_sched_midnight / 86400 + 1" ] },
      { "math": [ "br1_depart_1 = rand(11) + 6" ] },
      { "math": [ "br1_depart_2 = rand(11) + 6" ] },
      {
        "if": { "math": [ "abs(br1_depart_1 - br1_depart_2) < 2" ] },
        "then": [ { "math": [ "br1_depart_2 = br1_depart_1 >= 12 ? br1_depart_1 - 4 : br1_depart_1 + 4" ] } ]
      },
      { "math": [ "br1_depart_1_h = br1_depart_1 > 12 ? br1_depart_1 - 12 : br1_depart_1" ] },
      { "math": [ "br1_depart_2_h = br1_depart_2 > 12 ? br1_depart_2 - 12 : br1_depart_2" ] },
      {
        "if": { "math": [ "br1_depart_1 >= 12" ] },
        "then": [ { "set_string_var": "PM", "target_var": { "global_val": "br1_depart_1_ap" } } ],
        "else": [ { "set_string_var": "AM", "target_var": { "global_val": "br1_depart_1_ap" } } ]
      },
      {
        "if": { "math": [ "br1_depart_2 >= 12" ] },
        "then": [ { "set_string_var": "PM", "target_var": { "global_val": "br1_depart_2_ap" } } ],
        "else": [ { "set_string_var": "AM", "target_var": { "global_val": "br1_depart_2_ap" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_TICK",
    "//": "Run as a runner. u_br1_run_state: 0 home, 1 out on a run, 2 heading home, 3 missing (waiting to be found). A run lasts until 1-2 days after leaving (u_br1_run_turn; the runner waits at the destination till then), or ends early when the runner is badly hurt; it doesn't depend on how full their pack is. Off-screen, an NPC that reaches its goal soon picks a random new one, so every tick re-aims a runner who has strayed more than a square from where it should be. Only one runner is out at a time (global br1_runner_out). Blocks run in the order 3, 2, 1, 0 so one tick never does two steps.",
    "effect": [
      {
        "//": "On a run and more than a square from home: remember it (the board then says 'back for a rest' if they come home before the run ends, rather than right after they set off).",
        "if": { "and": [ { "math": [ "u_br1_run_state == 1" ] }, { "math": [ "distance('u', u_br1_home) > 24" ] } ] },
        "then": [ { "math": [ "u_br1_was_away = 1" ] } ]
      },
      {
        "if": { "math": [ "u_br1_run_state == 3" ] },
        "then": [
          {
            "if": { "math": [ "distance('u', br1_missing_point) > 24" ] },
            "then": [ { "u_set_goal": { "om_terrain": "br1_garage", "var": { "global_val": "br1_missing_point" } } } ]
          }
        ]
      },
      {
        "//": "Badly hurt on a run (torso or head under half, or in a lot of pain): cut it short and head home now.",
        "if": {
          "and": [
            { "math": [ "u_br1_run_state == 1" ] },
            {
              "or": [
                { "math": [ "u_hp('torso') < u_hp_max('torso') / 2" ] },
                { "math": [ "u_hp('head') < u_hp_max('head') / 2" ] },
                { "math": [ "u_pain() > 40" ] }
              ]
            }
          ]
        },
        "then": [ { "math": [ "u_br1_run_state = 2" ] }, { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_home" } } } ]
      },
      {
        "if": { "math": [ "u_br1_run_state == 2" ] },
        "then": [
          {
            "if": { "math": [ "distance('u', u_br1_home) <= 24" ] },
            "then": [
              { "math": [ "u_br1_run_state = 0" ] },
              { "math": [ "u_br1_run_next = time('now') + time('12 h')" ] },
              { "math": [ "br1_runner_out = 0" ] },
              { "math": [ "br1_runs_done += 1" ] },
              { "math": [ "br1_stores_bonus = min(br1_stores_bonus + 1, 3)" ] },
              { "mapgen_update": "br1_breakroom_restock", "target_var": { "u_val": "br1_home" } },
              { "run_eocs": "EOC_BR1_DEPOT_RESTOCK" }
            ],
            "else": [ { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_home" } } } ]
          }
        ]
      },
      {
        "if": { "math": [ "u_br1_run_state == 1" ] },
        "then": [
          {
            "if": { "math": [ "distance('u', u_br1_dest) > 24" ] },
            "then": [ { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_dest" } } } ],
            "else": [
              {
                "if": { "math": [ "time('now') >= u_br1_run_turn" ] },
                "then": [
                  {
                    "if": { "and": [ { "math": [ "u_br1_doomed == 1" ] }, { "math": [ "br1_runner_missing == 0" ] } ] },
                    "then": [
                      { "math": [ "u_br1_run_state = 3" ] },
                      { "math": [ "u_br1_doomed = 0" ] },
                      { "math": [ "br1_runner_missing = 1" ] },
                      { "math": [ "br1_missing_who = br1_tick_who" ] },
                      { "u_location_variable": { "global_val": "br1_missing_point" } }
                    ],
                    "else": [
                      { "math": [ "u_br1_run_state = 2" ] },
                      { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_home" } } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": { "math": [ "u_br1_run_state == 0" ] },
        "then": [
          {
            "if": { "and": [ { "math": [ "u_br1_home_set != 1" ] }, { "u_near_om_location": "br1_breakroom", "range": 0 } ] },
            "then": [ { "u_location_variable": { "u_val": "br1_home" } }, { "math": [ "u_br1_home_set = 1" ] } ]
          },
          {
            "if": { "math": [ "u_br1_home_set == 1" ] },
            "then": [
              {
                "if": { "math": [ "distance('u', u_br1_home) > 24" ] },
                "then": [ { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_home" } } } ],
                "else": [
                  {
                    "if": {
                      "and": [
                        { "math": [ "br1_runner_out == 0" ] },
                        { "math": [ "time('now') >= u_br1_run_next" ] },
                        { "math": [ "u_br1_left_day != br1_sched_day" ] },
                        { "math": [ "time_since('midnight') >= br1_tick_depart * 3600" ] }
                      ]
                    },
                    "then": [ { "run_eocs": "EOC_BR1_RUNNER_SEND" } ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "//": "Copy this runner's errand state to globals for the runner board, which the player reads.",
        "if": { "math": [ "br1_tick_who == 1" ] },
        "then": [
          { "math": [ "br1_rs_1 = u_br1_run_state" ] },
          { "math": [ "br1_rn_1 = u_br1_run_next" ] },
          { "math": [ "br1_ld_1 = u_br1_left_day" ] },
          { "math": [ "br1_rd_1 = u_br1_run_dest" ] },
          { "math": [ "br1_ah_1 = ( u_br1_was_away == 1 ) * ( distance('u', u_br1_home) <= 24 )" ] }
        ],
        "else": [
          { "math": [ "br1_rs_2 = u_br1_run_state" ] },
          { "math": [ "br1_rn_2 = u_br1_run_next" ] },
          { "math": [ "br1_ld_2 = u_br1_left_day" ] },
          { "math": [ "br1_rd_2 = u_br1_run_dest" ] },
          { "math": [ "br1_ah_2 = ( u_br1_was_away == 1 ) * ( distance('u', u_br1_home) <= 24 )" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_SEND",
    "//": "Run as a runner at home at their departure hour: pick a squatter camp (1), an elevator lobby (2) or a generator room (3) 3-30 squares away (EOC_BR1_RUNNER_FIND_*, falling back to the other kinds; these are rare, 3-8 of each per overmap, so a 12-square search usually found nothing and the runner stayed home) and set off. If none is found, the runner goes scavenging (4) at an ordinary garage square 4-10 squares away. u_br1_dest starts as the runner's own spot, so if even that fails it stays close and there is no run today (u_br1_left_day marks today either way). Goals and mission targets that use a var also name an om_terrain: the game ignores the var when om_terrain is empty and uses the NPC's own square. 1 run in 10 goes wrong (u_br1_doomed): the runner reaches the place and doesn't come back.",
    "effect": [
      { "math": [ "u_br1_run_dest = rand(2) + 1" ] },
      { "u_location_variable": { "u_val": "br1_dest" } },
      {
        "//": "Each search only runs when the map has such a place 3-30 squares away (u_near_om_location), because a target search that finds nothing pops a debug error.",
        "if": { "math": [ "u_br1_run_dest == 1" ] },
        "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_CAMP" } ]
      },
      { "if": { "math": [ "u_br1_run_dest == 2" ] }, "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_LOBBY" } ] },
      { "if": { "math": [ "u_br1_run_dest == 3" ] }, "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_GENERATOR" } ] },
      {
        "//": "Nothing of the chosen kind nearby: try the other kinds, then a scavenging run through the lanes.",
        "if": { "math": [ "distance('u', u_br1_dest) < 48" ] },
        "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_CAMP" } ]
      },
      { "if": { "math": [ "distance('u', u_br1_dest) < 48" ] }, "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_LOBBY" } ] },
      { "if": { "math": [ "distance('u', u_br1_dest) < 48" ] }, "then": [ { "run_eocs": "EOC_BR1_RUNNER_FIND_GENERATOR" } ] },
      {
        "if": { "and": [ { "math": [ "distance('u', u_br1_dest) < 48" ] }, { "u_near_om_location": "br1_garage", "range": 10 } ] },
        "then": [
          { "math": [ "u_br1_run_dest = 4" ] },
          {
            "u_location_variable": { "u_val": "br1_dest" },
            "target_params": { "om_terrain": "br1_garage", "random": true, "search_range": 10, "min_distance": 4, "z": 0 }
          }
        ]
      },
      { "math": [ "u_br1_left_day = br1_sched_day" ] },
      { "math": [ "u_br1_was_away = 0" ] },
      {
        "if": { "math": [ "distance('u', u_br1_dest) < 48" ] },
        "then": [ { "math": [ "u_br1_run_dest = 0" ] } ],
        "else": [
          { "u_set_goal": { "om_terrain": "br1_garage", "var": { "u_val": "br1_dest" } } },
          { "math": [ "u_br1_run_state = 1" ] },
          { "math": [ "u_br1_run_turn = time('now') + time('1 d') + rand(86400)" ] },
          { "math": [ "br1_runner_out = 1" ] },
          {
            "if": { "and": [ { "math": [ "br1_runner_missing == 0" ] }, { "x_in_y_chance": { "x": 1, "y": 10 } } ] },
            "then": [ { "math": [ "u_br1_doomed = 1" ] } ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_FIND_CAMP",
    "//": "Run as a runner from EOC_BR1_RUNNER_SEND: aim u_br1_dest at a squatter camp 3-30 squares away, if the map has one there (destination kind 1).",
    "condition": {
      "and": [
        { "u_near_om_location": "br1_squatter_camp", "range": 30 },
        { "not": { "u_near_om_location": "br1_squatter_camp", "range": 2 } }
      ]
    },
    "effect": [
      { "math": [ "u_br1_run_dest = 1" ] },
      {
        "u_location_variable": { "u_val": "br1_dest" },
        "target_params": { "om_terrain": "br1_squatter_camp", "random": true, "search_range": 30, "min_distance": 3, "z": 0 }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_FIND_LOBBY",
    "//": "As EOC_BR1_RUNNER_FIND_CAMP, for an elevator lobby (kind 2).",
    "condition": {
      "and": [
        { "u_near_om_location": "br1_elevator_lobby", "range": 30 },
        { "not": { "u_near_om_location": "br1_elevator_lobby", "range": 2 } }
      ]
    },
    "effect": [
      { "math": [ "u_br1_run_dest = 2" ] },
      {
        "u_location_variable": { "u_val": "br1_dest" },
        "target_params": { "om_terrain": "br1_elevator_lobby", "random": true, "search_range": 30, "min_distance": 3, "z": 0 }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_FIND_GENERATOR",
    "//": "As EOC_BR1_RUNNER_FIND_CAMP, for a generator room (kind 3).",
    "condition": {
      "and": [
        { "u_near_om_location": "br1_generator_site", "range": 30 },
        { "not": { "u_near_om_location": "br1_generator_site", "range": 2 } }
      ]
    },
    "effect": [
      { "math": [ "u_br1_run_dest = 3" ] },
      {
        "u_location_variable": { "u_val": "br1_dest" },
        "target_params": { "om_terrain": "br1_generator_site", "random": true, "search_range": 30, "min_distance": 3, "z": 0 }
      }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_RUNNER",
    "dynamic_line": {
      "math": [ "n_br1_run_state == 3" ],
      "yes": "You came out here for me?  Dot sent you?  Oh, thank God.  I twisted my ankle running from a pack, and I've been hiding in here ever since, listening to them sniff at the door.  I've got no water left.  Can you get me home?",
      "no": {
        "math": [ "n_br1_run_state == 1" ],
        "yes": {
          "math": [ "n_br1_run_dest == 1" ],
          "yes": "On a run for Dot.  Out to one of the squatter camps to trade and see who's still alive.  Don't hold me up; I want to be back before the lights go.",
          "no": {
            "math": [ "n_br1_run_dest == 2" ],
            "yes": "On a run for Dot.  Checking a lobby for Marcus: is it still there, do the lifts still come, did anything turn up in the bin.",
            "no": {
              "math": [ "n_br1_run_dest == 3" ],
              "yes": "On a run for Dot.  There's a generator room out this way.  If somebody's left a can of gas there, it's coming home with me.",
              "no": "On a run for Dot.  Nothing on the list this week, so I'm working the lanes: car trunks, glove boxes, whatever the last lot missed."
            }
          }
        },
        "no": {
          "math": [ "n_br1_run_state == 2" ],
          "yes": "Heading back to the Breakroom with what I found.  Walk with me if you like, but keep up.",
          "no": "Between runs.  Dot'll send me out again soon enough.  Somebody has to know what's out there this week, not last week."
        }
      }
    },
    "responses": [
      {
        "text": "Let's get you home.  The Breakroom's waiting.",
        "condition": { "math": [ "n_br1_run_state == 3" ] },
        "effect": [
          { "math": [ "n_br1_run_state = 2" ] },
          { "math": [ "br1_runner_missing = 0" ] },
          { "npc_set_goal": { "om_terrain": "br1_garage", "var": { "npc_val": "br1_home" } } },
          {
            "if": { "x_in_y_chance": { "x": 1, "y": 2 } },
            "then": [
              { "u_spawn_monster": "mon_br_hound", "real_count": 2, "min_radius": 10, "max_radius": 14 },
              { "message": "Out in the dark, claws click on concrete.  The pack heard you talking.", "type": "bad" }
            ]
          }
        ],
        "topic": "TALK_BR1_RUNNER_FOUND"
      },
      {
        "text": "Here, have some water.",
        "condition": { "and": [ { "math": [ "n_br1_run_state == 3" ] }, { "u_has_item": "almond_water" } ] },
        "effect": [ { "u_consume_item": "almond_water", "count": 1 }, { "math": [ "faction_like('br_breakroom') += 3" ] } ],
        "topic": "TALK_BR1_RUNNER_WATER"
      },
      {
        "text": "What's it like out there this week?",
        "condition": { "math": [ "n_br1_run_state != 3" ] },
        "topic": "TALK_BR1_RUNNER_NEWS"
      },
      { "text": "Take care out there.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_RUNNER_FOUND",
    "dynamic_line": "Okay.  Okay.  I can walk if I lean on the wall.  I'll head straight back; you don't have to carry me.  Tell Dot I'm coming.  Tell her I'm sorry about the trade goods.",
    "responses": [ { "text": "Go.  I'll watch your back.", "topic": "TALK_DONE" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_RUNNER_WATER",
    "dynamic_line": "Oh, that's good.  That's so good.  Thank you.  I won't forget it.",
    "responses": [ { "text": "Let's get you home.", "topic": "TALK_BR1_RUNNER" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_RUNNER_NEWS",
    "dynamic_line": [
      "More dead lights than last week.  Every week there's more dark between the lanes, and the Smilers like it.",
      "One of the lobbies near the ramps went black on me for an hour.  I sat in the corner with my flashlight off and counted to three thousand.",
      "There's a woman calling for help two rows over from the camps.  Don't go.  Whatever that is, it isn't a woman.",
      "Saw a faceling at a parked car, just standing there with its hand on the door.  It didn't do anything.  I hate that they don't do anything.",
      "Squatters are short on water again.  They'll trade almost anything for almond water.",
      "Hounds are thicker by the stairwells.  Go round, not through."
    ],
    "responses": [ { "text": "Thanks for the warning.", "topic": "TALK_BR1_RUNNER" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_FOREMAN_RUNNERS",
    "dynamic_line": {
      "math": [ "br1_runner_missing == 1" ],
      "yes": {
        "math": [ "br1_missing_who == 1" ],
        "yes": "Jonah's overdue.  A day, maybe more.  He's never late; he's annoying about it.  If you've got a job in you, I'd take it as a kindness.",
        "no": "Rosa's overdue.  A day, maybe more.  She's never late.  If you've got a job in you, I'd take it as a kindness."
      },
      "no": {
        "math": [ "br1_runner_out == 1" ],
        "yes": "One of my runners is out: a camp, a lobby or a generator room, whatever needs eyes this week.  Back in a day or two.  They bring back what they can and it goes in the stores.",
        "no": "Both in, for now.  Jonah and Rosa: they run out to the camps and lobbies and bring back news and whatever they can carry.  I send one at a time.  I'm not losing two in one week."
      }
    },
    "responses": [ { "text": "Something else.", "topic": "TALK_BR1_FOREMAN" } ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_BR1_JOB_RUNNER",
    "dynamic_line": "My runner's overdue.  I've marked where they were headed.  Go and find them, and if they're alive, get them walking home.  Please.",
    "responses": [
      {
        "text": "I'll find them.",
        "effect": { "assign_mission": "MISSION_BR1_FIND_RUNNER" },
        "topic": "TALK_BR1_JOB_TAKEN_DOT"
      },
      { "text": "Not right now.", "topic": "TALK_BR1_FOREMAN_WORK" }
    ]
  },
  {
    "type": "mission_definition",
    "id": "MISSION_BR1_FIND_RUNNER",
    "name": { "str": "Find the runner" },
    "description": "One of Dot's runners is overdue.  Go to the place marked on your map, find them, and talk to them to get them heading home.  Then tell Dot.",
    "goal": "MGOAL_CONDITION",
    "//goal": "Handed in at the Breakroom (camps_handins.json), not completed out in the lanes.",
    "goal_condition": { "math": [ "u_br1_handed_runner == 1" ] },
    "difficulty": 3,
    "value": 0,
    "origins": [ "ORIGIN_SECONDARY" ],
    "has_generic_rewards": false,
    "start": {
      "effect": [ { "math": [ "u_br1_handed_runner = 0" ] } ],
      "assign_mission_target": { "om_terrain": "br1_garage", "var": { "global_val": "br1_missing_point" }, "reveal_radius": 1 }
    },
    "end": {
      "effect": [
        { "u_spawn_item": "almond_water", "container": "bottle_almond_water" },
        { "u_spawn_item": "almond_water", "container": "bottle_almond_water" },
        { "u_spawn_item": "br_cat_medical", "use_item_group": true, "count": 2 },
        { "math": [ "faction_like('br_breakroom') += 8" ] },
        { "run_eocs": "EOC_BR1_STANDING_UP" }
      ]
    },
    "dialogue": {
      "describe": "One of my runners hasn't come back.",
      "offer": "My runner's overdue.  I've marked where they were headed.  Find them.",
      "accepted": "Thank you.  Take water; they'll need it.",
      "rejected": "Then I'll wait.  I'm good at waiting.",
      "advice": "They'll have holed up somewhere with a door.  Runners know to hide, not to fight.  Talk to them, they'll walk home on their own.",
      "inquire": "Any sign of them?",
      "success": "You found them.  Thank you.  Here, this is from all of us.",
      "success_lie": "Don't tell me that unless it's true.",
      "failure": "Right.  Thank you for looking."
    }
  },
  {
    "type": "furniture",
    "id": "f_br1_runner_board",
    "copy-from": "f_sign",
    "looks_like": "f_sign",
    "name": "runner board",
    "description": "A whiteboard screwed to a post, with the runners' names down one side in Dot's square capitals.  Dot rubs it clean every midnight and chalks up the day's departures.",
    "delete": { "flags": [ "SIGN", "SIGN_ALWAYS" ] },
    "examine_action": { "type": "effect_on_condition", "effect_on_conditions": [ "EOC_BR1_RUNNER_BOARD_READ" ] }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_BOARD_READ",
    "//": "Examining the runner board: one line per runner from the globals EOC_BR1_RUNNER_TICK keeps (br1_rs_N state, br1_rn_N next allowed run, br1_ld_N day of last departure, br1_rd_N destination).",
    "effect": [
      { "run_eocs": "EOC_BR1_RUNNER_SCHEDULE" },
      { "set_string_var": "JONAH", "target_var": { "global_val": "br1_bl_name" } },
      { "math": [ "br1_bl_dead = br1_runner_dead_1" ] },
      { "math": [ "br1_bl_state = br1_rs_1" ] },
      { "math": [ "br1_bl_next = br1_rn_1" ] },
      { "math": [ "br1_bl_left = br1_ld_1" ] },
      { "math": [ "br1_bl_dest = br1_rd_1" ] },
      { "math": [ "br1_bl_home = br1_ah_1" ] },
      { "math": [ "br1_bl_depart = br1_depart_1" ] },
      { "math": [ "br1_bl_h = br1_depart_1_h" ] },
      {
        "set_string_var": "<global_val:br1_depart_1_ap>",
        "target_var": { "global_val": "br1_bl_ap" },
        "parse_tags": true
      },
      { "run_eocs": "EOC_BR1_RUNNER_BOARD_LINE" },
      {
        "set_string_var": "<global_val:br1_bl_line>",
        "target_var": { "global_val": "br1_board_1" },
        "parse_tags": true
      },
      { "set_string_var": "ROSA", "target_var": { "global_val": "br1_bl_name" } },
      { "math": [ "br1_bl_dead = br1_runner_dead_2" ] },
      { "math": [ "br1_bl_state = br1_rs_2" ] },
      { "math": [ "br1_bl_next = br1_rn_2" ] },
      { "math": [ "br1_bl_left = br1_ld_2" ] },
      { "math": [ "br1_bl_dest = br1_rd_2" ] },
      { "math": [ "br1_bl_home = br1_ah_2" ] },
      { "math": [ "br1_bl_depart = br1_depart_2" ] },
      { "math": [ "br1_bl_h = br1_depart_2_h" ] },
      {
        "set_string_var": "<global_val:br1_depart_2_ap>",
        "target_var": { "global_val": "br1_bl_ap" },
        "parse_tags": true
      },
      { "run_eocs": "EOC_BR1_RUNNER_BOARD_LINE" },
      {
        "set_string_var": "<global_val:br1_bl_line>",
        "target_var": { "global_val": "br1_board_2" },
        "parse_tags": true
      },
      {
        "u_message": "The runner board, in Dot's square capitals:\n\nRUNNERS\n<global_val:br1_board_1>\n<global_val:br1_board_2>\n\nONE OUT AT A TIME.  NO EXCEPTIONS.",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_RUNNER_BOARD_LINE",
    "//": "Builds one board line (br1_bl_line) from the br1_bl_* globals EOC_BR1_RUNNER_BOARD_READ sets.",
    "effect": [
      {
        "if": { "math": [ "br1_bl_dead == 1" ] },
        "then": [
          {
            "set_string_var": "<global_val:br1_bl_name>: name crossed out.  Nobody has rubbed it off.",
            "target_var": { "global_val": "br1_bl_line" },
            "parse_tags": true
          }
        ],
        "else": [
          {
            "if": { "math": [ "br1_bl_state == 3" ] },
            "then": [
              {
                "set_string_var": "<global_val:br1_bl_name>: OVERDUE.",
                "target_var": { "global_val": "br1_bl_line" },
                "parse_tags": true
              }
            ],
            "else": [
              {
                "if": { "or": [ { "math": [ "br1_bl_state == 1" ] }, { "math": [ "br1_bl_state == 2" ] } ] },
                "then": [
                  {
                    "if": { "math": [ "br1_bl_dest == 1" ] },
                    "then": [
                      {
                        "set_string_var": "<global_val:br1_bl_name>: OUT, to the squatter camps.  Back in a day or two.",
                        "target_var": { "global_val": "br1_bl_line" },
                        "parse_tags": true
                      }
                    ],
                    "else": [
                      {
                        "if": { "math": [ "br1_bl_dest == 2" ] },
                        "then": [
                          {
                            "set_string_var": "<global_val:br1_bl_name>: OUT, to a lobby.  Back in a day or two.",
                            "target_var": { "global_val": "br1_bl_line" },
                            "parse_tags": true
                          }
                        ],
                        "else": [
                          {
                            "if": { "math": [ "br1_bl_dest == 3" ] },
                            "then": [
                              {
                                "set_string_var": "<global_val:br1_bl_name>: OUT, to a generator room.  Back in a day or two.",
                                "target_var": { "global_val": "br1_bl_line" },
                                "parse_tags": true
                              }
                            ],
                            "else": [
                              {
                                "set_string_var": "<global_val:br1_bl_name>: OUT, scavenging the lanes.  Back in a day or two.",
                                "target_var": { "global_val": "br1_bl_line" },
                                "parse_tags": true
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "if": { "math": [ "br1_bl_left == br1_sched_day" ] },
                    "then": [
                      {
                        "set_string_var": "<global_val:br1_bl_name>: in.  Done for today.",
                        "target_var": { "global_val": "br1_bl_line" },
                        "parse_tags": true
                      }
                    ],
                    "else": [
                      {
                        "if": { "math": [ "br1_bl_next > br1_sched_midnight + br1_bl_depart * 3600" ] },
                        "then": [
                          {
                            "set_string_var": "<global_val:br1_bl_name>: in.  Resting.  No run today.",
                            "target_var": { "global_val": "br1_bl_line" },
                            "parse_tags": true
                          }
                        ],
                        "else": [
                          {
                            "if": { "math": [ "time_since('midnight') < br1_bl_depart * 3600" ] },
                            "then": [
                              {
                                "set_string_var": "<global_val:br1_bl_name>: in.  Leaves at <global_val:br1_bl_h> <global_val:br1_bl_ap>.",
                                "target_var": { "global_val": "br1_bl_line" },
                                "parse_tags": true
                              }
                            ],
                            "else": [
                              {
                                "if": { "math": [ "br1_runner_out == 1" ] },
                                "then": [
                                  {
                                    "set_string_var": "<global_val:br1_bl_name>: in.  Was due out at <global_val:br1_bl_h> <global_val:br1_bl_ap>; waiting for the other runner to get back.",
                                    "target_var": { "global_val": "br1_bl_line" },
                                    "parse_tags": true
                                  }
                                ],
                                "else": [
                                  {
                                    "set_string_var": "<global_val:br1_bl_name>: in.  Due out at <global_val:br1_bl_h> <global_val:br1_bl_ap>.  Any minute now.",
                                    "target_var": { "global_val": "br1_bl_line" },
                                    "parse_tags": true
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "//": "Back at the Breakroom partway through a run (came home to sleep or rest): say so instead of OUT. br1_bl_home comes from the 10-minute tick (br1_ah_N).",
        "if": { "and": [ { "math": [ "br1_bl_dead != 1" ] }, { "math": [ "br1_bl_state == 1" ] }, { "math": [ "br1_bl_home == 1" ] } ] },
        "then": [
          {
            "set_string_var": "<global_val:br1_bl_name>: back for a rest.  Heading out again after.",
            "target_var": { "global_val": "br1_bl_line" },
            "parse_tags": true
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_DEPOT_RESTOCK",
    "//": "A runner home restocks the supply depot. The two Breakroom layouts keep it in different places, so look at the Breakroom first: barbed wire means the Bunker, else chain-link fence means the Checkpoint; an old Breakroom (neither) has no depot. The search starts at the Breakroom square's corner, radius 21.",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_depot_probe" },
        "target_params": { "om_terrain": "br1_breakroom", "z": 0 },
        "terrain": "t_fence_barbed",
        "target_max_radius": 21,
        "true_eocs": [ "EOC_BR1_DEPOT_RESTOCK_BUNKER" ],
        "false_eocs": [ "EOC_BR1_DEPOT_RESTOCK_CHECK_CHECKPOINT" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_DEPOT_RESTOCK_CHECK_CHECKPOINT",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_depot_probe" },
        "target_params": { "om_terrain": "br1_breakroom", "z": 0 },
        "terrain": "t_chainfence",
        "target_max_radius": 21,
        "true_eocs": [ "EOC_BR1_DEPOT_RESTOCK_CHECKPOINT" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_DEPOT_RESTOCK_BUNKER",
    "effect": [ { "mapgen_update": "br1_depot_restock_bunker", "target_var": { "global_val": "br1_depot_probe" } } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_DEPOT_RESTOCK_CHECKPOINT",
    "effect": [ { "mapgen_update": "br1_depot_restock_checkpoint", "target_var": { "global_val": "br1_depot_probe" } } ]
  }
]
