  {
    "type": "npc_class",
    "id": "NC_BR1_RUNNER",
    "name": { "str": "Runner" },
    "job_description": "I run errands for Dot.  Out to the camps and the lobbies, and back again.",
    "common": false,
    "//": "Only two runners keep the Breakroom supplied, so they are its best fighters: high melee, cutting, dodge and pistol skills, a machete in a scabbard and a Glock 19 with spare magazines, a leather jacket, and a first aid kit with plenty of bandages and painkillers. +2 Strength and Dexterity (nothing they carry needs more than the base roll).",
    "worn_override": "NC_BR1_RUNNER_worn",
    "weapon_override": "NC_BR1_RUNNER_weapon",
    "carry_override": "NC_BR1_RUNNER_carry",
    "traits": [ { "group": "Appearance_demographics" } ],
    "bonus_str": { "constant": 2 },
    "bonus_dex": { "rng": [ 2, 3 ] },
    "bonus_per": { "rng": [ 0, 2 ] },
    "skills": [
      { "skill": "ALL", "level": { "sum": [ { "dice": [ 3, 2 ] }, { "constant": -2 } ] } },
      { "skill": "melee", "bonus": { "rng": [ 5, 6 ] } },
      { "skill": "cutting", "bonus": { "rng": [ 5, 6 ] } },
      { "skill": "dodge", "bonus": { "rng": [ 5, 6 ] } },
      { "skill": "gun", "bonus": { "rng": [ 3, 4 ] } },
      { "skill": "pistol", "bonus": { "rng": [ 3, 5 ] } },
      { "skill": "firstaid", "bonus": { "rng": [ 3, 4 ] } },
      { "skill": "survival", "bonus": { "rng": [ 2, 4 ] } }
    ]
  },
