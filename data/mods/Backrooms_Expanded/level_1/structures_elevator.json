    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_FOLLOWER",
    "//": "Run on each NPC near the player: followers ride along.",
    "condition": "u_following",
    "effect": [ { "u_teleport": { "global_val": "br1_elevator_dest" }, "force_safe": true } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_NORMAL",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_elevator_dest" },
        "target_params": { "om_terrain": "br1_elevator_lobby", "var": { "global_val": "br1_elevator_target" }, "z": 0 },
        "x_adjust": 12,
        "y_adjust": 6
      },
      { "run_eocs": "EOC_BR1_ELEVATOR_MOVE" },
      { "math": [ "u_br1_lobby_arrivals++" ] },
      { "turn_cost": "1 m" },
      {
        "u_message": "Ding.\n\nThe doors close.  No music, no floor numbers, just a long, smooth glide that could be up, down or sideways.  The doors open on a lobby.",
        "type": "neutral",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_WRONG_FLOOR",
    "//": "The doors open on a dead zone instead (or a garage square turned into one). Not revealed on the map; there's no elevator behind you.",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_elevator_dest" },
        "target_params": {
          "om_terrain": "br1_dead_zone",
          "om_terrain_replace": "br1_garage",
          "random": true,
          "search_range": 30,
          "min_distance": 5,
          "z": 0
        },
        "x_adjust": 12,
        "y_adjust": 8
      },
      { "run_eocs": "EOC_BR1_ELEVATOR_MOVE" },
      {
        "u_message": "Wrong floor.\n\nThe car drops, hard, and stops.  The doors open on darkness and the smell of oil.  This isn't a lobby.  You step out, and when you turn around there is only bare concrete where the doors were.",
        "type": "bad",
        "popup": true
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_STUCK",
    "//": "You still reach the lobby you picked, but you lose an hour, get thirsty and tired, and it shakes you.",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_elevator_dest" },
        "target_params": { "om_terrain": "br1_elevator_lobby", "var": { "global_val": "br1_elevator_target" }, "z": 0 },
        "x_adjust": 12,
        "y_adjust": 6
      },
      { "run_eocs": "EOC_BR1_ELEVATOR_MOVE" },
