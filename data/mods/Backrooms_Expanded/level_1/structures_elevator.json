  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_ROLL",
    "//": "Every ride is a small gamble. Out of 100: 74 normal, 8 wrong floor, 5 stuck, 4 company, 4 lucky floor, 3 bad lobby, 2 way out. The lobby you leave becomes 'Back'.",
    "effect": [
      {
        "u_location_variable": { "u_val": "br1_elevator_last" },
        "target_params": { "om_terrain": "br1_elevator_lobby", "var": { "u_val": "br1_elevator_here" }, "z": 0 },
        "x_adjust": 12,
        "y_adjust": 6
      },
      { "math": [ "u_br1_elevator_has_last = 1" ] },
      { "math": [ "br1_elevator_roll = rand(99)" ] },
      {
        "if": { "math": [ "br1_elevator_roll < 74" ] },
        "then": { "run_eocs": "EOC_BR1_ELEVATOR_NORMAL" },
        "else": {
          "if": { "math": [ "br1_elevator_roll < 82" ] },
          "then": { "run_eocs": "EOC_BR1_ELEVATOR_WRONG_FLOOR" },
          "else": {
            "if": { "math": [ "br1_elevator_roll < 87" ] },
            "then": { "run_eocs": "EOC_BR1_ELEVATOR_STUCK" },
            "else": {
              "if": { "math": [ "br1_elevator_roll < 91" ] },
              "then": { "run_eocs": "EOC_BR1_ELEVATOR_COMPANY" },
              "else": {
                "if": { "math": [ "br1_elevator_roll < 95" ] },
                "then": { "run_eocs": "EOC_BR1_ELEVATOR_LUCKY" },
                "else": {
                  "if": { "math": [ "br1_elevator_roll < 98" ] },
                  "then": { "run_eocs": "EOC_BR1_ELEVATOR_BAD_LOBBY" },
                  "else": { "run_eocs": "EOC_BR1_ELEVATOR_WAY_OUT" }
                }
              }
            }
          }
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_MOVE",
    "//": "Followers within 6 tiles go first, then the player (the player's teleport reloads the map, and NPCs are reloaded from wherever they now stand). Every arrival chimes, loud enough for nearby things to hear.",
    "effect": [
      { "u_run_npc_eocs": [ "EOC_BR1_ELEVATOR_FOLLOWER" ], "local": true, "npc_range": 6 },
