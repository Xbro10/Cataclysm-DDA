  {
    "type": "talk_topic",
    "id": "TALK_BR1_ELEVATOR_PANEL",
    "//": "The call panel. 'Back' and 'Home' only show once you have somewhere to go back to.",
    "dynamic_line": "A brushed steel panel beside the doors.  Three round buttons and no numbers: one worn smooth by a lot of thumbs, one with an arrow scratched into it, and one that someone could mark with a dab of paint.",
    "responses": [
      {
        "text": "Press the worn button.  (Any floor)",
        "effect": { "run_eocs": "EOC_BR1_ELEVATOR_PICK_ANY" },
        "topic": "TALK_DONE"
      },
      {
        "text": "Press the arrow.  (Back where you came from)",
        "condition": { "math": [ "u_br1_elevator_has_last == 1" ] },
        "effect": { "run_eocs": "EOC_BR1_ELEVATOR_PICK_BACK" },
        "topic": "TALK_DONE"
      },
      {
        "text": "Press the painted button.  (Home)",
        "condition": { "math": [ "u_br1_elevator_has_home == 1" ] },
        "effect": { "run_eocs": "EOC_BR1_ELEVATOR_PICK_HOME" },
        "topic": "TALK_DONE"
      },
      {
        "text": "Daub paint on the third button.  (Make this lobby home)",
        "effect": { "run_eocs": "EOC_BR1_ELEVATOR_SET_HOME" },
        "topic": "TALK_DONE"
      },
      { "text": "Step away.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "effect_on_condition",
