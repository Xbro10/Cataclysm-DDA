  {
    "type": "effect_on_condition",
    "id": "EOC_BR1_ELEVATOR_RIDE",
    "//": "Pick a random lobby 5-30 squares away (or turn a garage square into one if none exists), mark it on the map, move followers within 6 tiles there, then the player. Followers go first: the player's teleport reloads the map, and NPCs are reloaded from wherever they now stand.",
    "effect": [
      {
        "u_location_variable": { "global_val": "br1_elevator_dest" },
        "target_params": {
          "om_terrain": "br1_elevator_lobby",
          "om_terrain_replace": "br1_garage",
          "random": true,
          "search_range": 30,
          "min_distance": 5,
          "reveal_radius": 1,
          "z": 0
        },
        "x_adjust": 12,
        "y_adjust": 6
      },
      { "u_run_npc_eocs": [ "EOC_BR1_ELEVATOR_FOLLOWER" ], "local": true, "npc_range": 6 },
      { "u_teleport": { "global_val": "br1_elevator_dest" }, "force_safe": true },
      { "turn_cost": "1 m" },
      {
        "u_message": "The doors close.  No music, no floor numbers, just a long, smooth glide that could be up, down or sideways.  The doors open on a lobby you've never seen.",
        "type": "neutral"
      }
    ]
  },
  {
