[
  {
    "type": "palette",
    "id": "backrooms_palette",
    "extending": true,
    "//": "Extends the upstream Level 0 palette (data/mods/Backrooms/palettes.json): plain floor (\" \") no longer has a 5% chance per tile to be a ceiling light, so lights stop being scattered at random. They come from the grid in the backfloorchamber mapgen below instead. Rooms that draw lights on purpose (\".\" and \";\") keep them.",
    "terrain": { " ": "t_carpet_backrooms" }
  },
  {
    "type": "ter_furn_transform",
    "id": "br0_ceiling_light",
    "//": "One spot of the Level 0 light grid: carpet or tile floor gets a ceiling light, 6 spots in 7 (the rest stay dark). Anything else (walls, doors, lit floor) is left alone.",
    "terrain": [
      {
        "result": [ [ "t_carpet_backrooms_light", 6 ], [ "t_carpet_backrooms", 1 ] ],
        "valid_terrain": [ "t_carpet_backrooms" ]
      },
      {
        "result": [ [ "t_tile_backrooms_light", 6 ], [ "t_tile_backrooms", 1 ] ],
        "valid_terrain": [ "t_tile_backrooms" ]
      }
    ]
  },
  {
    "type": "mapgen",
    "om_terrain": [ "backfloorchamber" ],
    "weight": 100000,
    "//": "Copy of the upstream Level 0 mapgen (data/mods/Backrooms/overmap_terrain.json, TGWeaver's Backrooms mod) with additions: the Manila Room (br0_manila_room) in the small-room list, archway rooms and blackout zones (br0_archway_room, br0_blackout_room) in the big-room list (all in level_0/rooms.json), and the ceiling-light grid, a light every 4 tiles in rows and columns (x and y 2, 6, 10, 14, 18, 22), placed after the rooms so it lands on whatever floor they left. The high weight means this is used instead of upstream's (about 99 squares in 100). If upstream changes its version, copy the change here.",
    "object": {
      "fill_ter": "t_carpet_backrooms",
      "place_nested": [
        { "chunks": [ [ "mx_backrooms_whole", 100 ] ], "x": 0, "y": 0 },
        {
          "chunks": [
            [ "null", 250 ],
            [ "mx_backroom_big_empty", 50 ],
            [ "mx_backroom_big_generic", 50 ],
            [ "mx_backroom_big_common", 100 ],
            [ "mx_backroom_big_storage", 25 ],
            [ "mx_backroom_big_breakroom", 25 ],
            [ "mx_backroom_big_bathroom", 20 ],
            [ "br0_archway_room", 30 ],
            [ "br0_blackout_room", 15 ]
          ],
          "x": [ 0, 13 ],
          "y": [ 0, 13 ],
          "repeat": [ 0, 2 ]
        },
        {
          "chunks": [
            [ "null", 250 ],
            [ "mx_backroom_small_empty", 50 ],
            [ "mx_backroom_small_generic", 50 ],
            [ "mx_backroom_small_common", 100 ],
            [ "mx_backroom_small_storage", 25 ],
            [ "mx_backroom_small_breakroom", 25 ],
            [ "mx_backroom_small_bathroom", 20 ],
            [ "br0_manila_room", 5 ]
          ],
          "x": [ 0, 18 ],
          "y": [ 0, 18 ],
          "repeat": [ 0, 3 ]
        },
        { "chunks": [ "br0_light_grid" ], "x": 0, "y": 0 }
      ]
    }
  },
  {
    "type": "mapgen",
    "nested_mapgen_id": "br0_light_grid",
    "//": "The ceiling-light grid. It must be a nested chunk listed after the rooms: transforms placed directly in a mapgen run before its nested chunks, so the rooms would paint over them.",
