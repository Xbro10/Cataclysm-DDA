[
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_JOURNAL_ADD_LINE",
    "//": "Shared helper. u is the NPC writing; the caller puts the text in u_val sm_line. Appends 'Day N, <time of day>: <line>' and copies the journal to their item straight away.",
    "effect": [
      { "math": [ "u_sm_today = floor(time_since('cataclysm', 'unit':'days')) + 1" ] },
      { "math": [ "u_sm_hour = floor(time_since('midnight', 'unit':'hours'))" ] },
      {
        "if": { "and": [ { "math": [ "u_sm_hour >= 5" ] }, { "math": [ "u_sm_hour < 12" ] } ] },
        "then": { "set_string_var": "morning", "target_var": { "u_val": "sm_period" } },
        "else": {
          "if": { "and": [ { "math": [ "u_sm_hour >= 12" ] }, { "math": [ "u_sm_hour < 17" ] } ] },
          "then": { "set_string_var": "afternoon", "target_var": { "u_val": "sm_period" } },
          "else": {
            "if": { "and": [ { "math": [ "u_sm_hour >= 17" ] }, { "math": [ "u_sm_hour < 21" ] } ] },
            "then": { "set_string_var": "evening", "target_var": { "u_val": "sm_period" } },
            "else": { "set_string_var": "night", "target_var": { "u_val": "sm_period" } }
          }
        }
      },
      {
        "set_string_var": "Day <u_val:sm_today>, <u_val:sm_period>: <u_val:sm_line>",
        "target_var": { "u_val": "sm_entry" },
        "parse_tags": true
      },
      {
        "if": { "math": [ "has_var(u_sm_journal_text)" ] },
        "then": { "set_string_var": "<u_val:sm_journal_text>\n<u_val:sm_entry>", "target_var": { "u_val": "sm_journal_text" }, "parse_tags": true },
        "else": { "set_string_var": "<u_val:sm_entry>", "target_var": { "u_val": "sm_journal_text" }, "parse_tags": true }
      },
      { "run_eocs": "EOC_SM_JOURNAL_SYNC_ITEM" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_KILL_MONSTER",
    "//": "Fight: an NPC killed a monster. At most one fight entry every 4 hours.",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": {
      "and": [
        "u_is_npc",
        { "or": [ { "not": { "math": [ "has_var(u_sm_last_fight)" ] } }, { "math": [ "time_since(u_sm_last_fight) > time('4 h')" ] } ] }
      ]
    },
    "effect": [
      { "math": [ "u_sm_last_fight = time('now')" ] },
      { "set_string_var": "<sm_j_ev_fight>", "target_var": { "u_val": "sm_line" }, "parse_tags": true },
      { "run_eocs": "EOC_SM_JOURNAL_ADD_LINE" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_KILL_PERSON",
    "//": "Fight: an NPC killed a person. Shares the 4-hour fight limit, but a killing always gets written over a plain fight.",
    "eoc_type": "EVENT",
    "required_event": "character_kills_character",
    "condition": "u_is_npc",
    "effect": [
      { "math": [ "u_sm_last_fight = time('now')" ] },
      { "set_string_var": "<sm_j_ev_killed_person>", "target_var": { "u_val": "sm_line" }, "parse_tags": true },
      { "run_eocs": "EOC_SM_JOURNAL_ADD_LINE" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_ATE",
    "//": "Finding food after going hungry: an NPC eats while at the 'Starving' level. At most once every 12 hours.",
    "eoc_type": "EVENT",
    "required_event": "character_eats_item",
    "condition": {
      "and": [
        "u_is_npc",
        { "math": [ "u_hunger() >= 150" ] },
        { "or": [ { "not": { "math": [ "has_var(u_sm_last_ate)" ] } }, { "math": [ "time_since(u_sm_last_ate) > time('12 h')" ] } ] }
      ]
    },
    "effect": [
      { "math": [ "u_sm_last_ate = time('now')" ] },
      { "set_string_var": "<sm_j_ev_ate>", "target_var": { "u_val": "sm_line" }, "parse_tags": true },
      { "run_eocs": "EOC_SM_JOURNAL_ADD_LINE" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_HURT",
    "//": "Bookkeeping for rescues: remember when each NPC last took damage.",
    "eoc_type": "EVENT",
    "required_event": "character_takes_damage",
    "condition": "u_is_npc",
    "effect": [ { "math": [ "u_sm_last_hurt = time('now')" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_PLAYER_KILL",
    "//": "Rescue (best guess): when the player kills a monster, any NPC within 6 tiles who was hurt in the last 2 minutes counts as rescued.",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": "u_is_avatar",
    "effect": [
      { "set_string_var": "<u_name>", "target_var": { "global_val": "sm_rescuer" }, "parse_tags": true },
      { "u_run_npc_eocs": [ "EOC_SM_EV_RESCUED" ], "local": true, "npc_range": 6 }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_RESCUED",
    "//": "u is a nearby NPC. At most one rescue entry every 6 hours.",
    "condition": {
      "and": [
        { "math": [ "has_var(u_sm_last_hurt)" ] },
        { "math": [ "time_since(u_sm_last_hurt) <= time('2 m')" ] },
        { "or": [ { "not": { "math": [ "has_var(u_sm_last_rescue)" ] } }, { "math": [ "time_since(u_sm_last_rescue) > time('6 h')" ] } ] }
      ]
    },
    "effect": [
      { "math": [ "u_sm_last_rescue = time('now')" ] },
      { "set_string_var": "<global_val:sm_rescuer> <sm_j_ev_rescued>", "target_var": { "u_val": "sm_line" }, "parse_tags": true },
      { "run_eocs": "EOC_SM_JOURNAL_ADD_LINE" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_FOLLOWER_DIES",
    "//": "A friend dies: one of the player's followers dies. Their own journal ends; every other follower nearby writes about them.",
    "eoc_type": "EVENT",
    "required_event": "character_dies",
    "condition": { "and": [ "u_is_npc", "u_following" ] },
    "effect": [
      { "math": [ "u_sm_dying = 1" ] },
      { "set_string_var": "<u_name>", "target_var": { "global_val": "sm_dead_name" }, "parse_tags": true },
      {
        "if": { "math": [ "has_var(u_sm_journal_text)" ] },
        "then": [
          { "set_string_var": "<u_val:sm_journal_text>\n[The writing stops here.]", "target_var": { "u_val": "sm_journal_text" }, "parse_tags": true },
          { "run_eocs": "EOC_SM_JOURNAL_SYNC_ITEM" }
        ]
      },
      { "u_run_npc_eocs": [ "EOC_SM_EV_MOURN" ], "local": true }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SM_EV_MOURN",
    "//": "u is another NPC: only the player's other followers write, never the one who died.",
    "condition": { "and": [ "u_following", { "not": { "math": [ "u_sm_dying == 1" ] } } ] },
    "effect": [
      {
        "set_string_var": "<sm_j_ev_death_a> <global_val:sm_dead_name>.  <sm_j_ev_death_b>",
        "target_var": { "u_val": "sm_line" },
        "parse_tags": true
      },
      { "run_eocs": "EOC_SM_JOURNAL_ADD_LINE" }
    ]
  }
]
